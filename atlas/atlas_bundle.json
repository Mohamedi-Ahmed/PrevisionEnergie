  "entities/datalake_entities.json": {
    "zones": [
      {
        "qualifiedName": "prevision_energie.raw",
        "name": "Raw Zone",
        "description": "Zone de dépôt brut correspondant à la couche Bronze du projet.",
        "physicalPath": "data/bronze"
      },
      {
        "qualifiedName": "prevision_energie.curated",
        "name": "Curated Zone",
        "description": "Zone fiabilisée correspondant à la couche Silver du projet.",
        "physicalPath": "data/silver"
      },
      {
        "qualifiedName": "prevision_energie.consumption",
        "name": "Consumption Zone",
        "description": "Zone orientée analyse et restitution correspondant à la couche Gold du projet.",
        "physicalPath": "data/gold"
      }
    ]
  },
  "processes/lineage_processes.json": {
    "processes": [
      {
        "name": "bronze_ingestion",
        "inputs": [
          "kaggle.france_energy_weather_daily"
        ],
        "outputs": [
          "bronze.kaggle"
        ],
        "description": "Source ingestion into Bronze"
      },
      {
        "name": "silver_transformation",
        "inputs": [
          "bronze.kaggle"
        ],
        "outputs": [
          "silver.energy_weather_daily"
        ],
        "description": "Cleaning, typing, normalization, enrichment"
      },
      {
        "name": "gold_dwh_load",
        "inputs": [
          "silver.energy_weather_daily"
        ],
        "outputs": [
          "gold.dim_date",
          "gold.dim_region",
          "gold.dim_energy",
          "gold.dim_weather_context",
          "gold.fact_energy_consumption_daily",
          "gold.gold_daily_features"
        ],
        "description": "Build dimensions, fact table and Gold restitution dataset"
      },
      {
        "name": "api_exposure",
        "inputs": [
          "gold.gold_daily_features"
        ],
        "outputs": [
          "api.features"
        ],
        "description": "API consumption layer"
      }
    ]
  },
  "processes/datalake_processes.json": {
    "processes": [
      {
        "qualifiedName": "process.raw_to_curated",
        "name": "Raw to Curated",
        "inputs": [
          "prevision_energie.raw"
        ],
        "outputs": [
          "prevision_energie.curated"
        ],
        "description": "Transformation batch de la zone brute vers la zone fiabilisée."
      },
      {
        "qualifiedName": "process.curated_to_consumption",
        "name": "Curated to Consumption",
        "inputs": [
          "prevision_energie.curated"
        ],
        "outputs": [
          "prevision_energie.consumption"
        ],
        "description": "Chargement des tables analytiques et des datasets de restitution."
      }
    ]
  }
}